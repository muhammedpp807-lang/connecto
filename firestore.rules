rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null || true;

      match /game_history/{historyId} {
        allow read, write: if true;
      }
    }

    // Conversations & Messages
    match /conversations/{convId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Statuses
    match /statuses/{statusId} {
      allow read, write: if true;
    }

    // Game Invitations
    match /game_invitations/{invitationId} {
      allow read, write: if true;
    }

    // Real-Time Game Rooms
    match /games/{gameId} {
      allow read, write: if true;
    }

    // Fallback collection match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
